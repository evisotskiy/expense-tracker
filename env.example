# Скопируйте в .env:  cp env.example .env
# Этот файл читают docker compose и prisma.config.ts (packages/database).

# --- Postgres (значения совпадают с docker-compose.yml) ---
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense_tracker
POSTGRES_PORT=5432

# --- Подключение Prisma ---
DATABASE_URL="postgresql://expense:expense@localhost:5432/expense_tracker?schema=public"

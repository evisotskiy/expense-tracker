{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Монорепозиторий трекера расходов: Next.js + Nest.js + Prisma/Postgres",
  "packageManager": "pnpm@8.6.12",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.6.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml,prisma}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml,prisma}\"",
    "db:generate": "pnpm --filter @expense-tracker/database db:generate",
    "db:migrate": "pnpm --filter @expense-tracker/database db:migrate",
    "db:deploy": "pnpm --filter @expense-tracker/database db:deploy",
    "db:push": "pnpm --filter @expense-tracker/database db:push",
    "db:studio": "pnpm --filter @expense-tracker/database db:studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3"
  }
}

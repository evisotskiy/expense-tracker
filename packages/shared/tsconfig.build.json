{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // CommonJS: Nest собирается в CJS, а Next одинаково хорошо потребляет оба формата
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}

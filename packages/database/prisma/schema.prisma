// Схема трекера расходов.
// Документация: https://www.prisma.io/docs
//
// Prisma 7: генератор называется `prisma-client`, поле `output` обязательно,
// а строка подключения задаётся не здесь, а в prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // Nest собирается в CommonJS, Next спокойно потребляет CJS — держим один формат на оба приложения.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Пользователи и аутентификация
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?

  /// Валюта по умолчанию для новых расходов, ISO 4217 (RUB, USD, EUR).
  baseCurrency String @default("RUB") @db.VarChar(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories    Category[]
  expenses      Expense[]
  budgets       Budget[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Хранится только хэш refresh-токена: утечка таблицы не даёт выпустить новый access-токен.
/// Каждая ротация создаёт новую строку и помечает старую revokedAt.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Домен: категории, расходы, бюджеты
// ---------------------------------------------------------------------------

model Category {
  id     String @id @default(cuid())
  userId String

  name  String
  /// Имя иконки из lucide-react, например "utensils".
  icon  String?
  /// HEX-цвет для графиков, например "#22c55e".
  color String? @db.VarChar(7)

  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]
  budgets  Budget[]

  /// Уникальность в рамках пользователя, а не глобально.
  @@unique([userId, name])
  @@index([userId, isArchived])
  @@map("categories")
}

model Expense {
  id         String  @id @default(cuid())
  userId     String
  /// Расход может остаться без категории (например, после её удаления) — поэтому SetNull.
  categoryId String?

  /// Decimal(12, 2): точная десятичная арифметика в Postgres, без ошибок округления
  /// при суммировании. На границе API преобразуется в строку — см. money.ts в shared.
  amount Decimal @db.Decimal(12, 2)

  /// ISO 4217. Дублируется в расходе, чтобы смена baseCurrency не переписывала историю.
  currency String @db.VarChar(3)

  note    String?  @db.VarChar(500)
  /// Когда деньги были потрачены (не когда запись создана).
  spentAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Главный запрос приложения: «расходы пользователя за период, свежие сверху».
  @@index([userId, spentAt(sort: Desc)])
  @@index([categoryId])
  @@map("expenses")
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

model Budget {
  id     String @id @default(cuid())
  userId String
  /// null = общий лимит на все расходы, иначе лимит по конкретной категории.
  categoryId String?

  amount Decimal @db.Decimal(12, 2)

  currency String       @db.VarChar(3)
  period   BudgetPeriod @default(MONTHLY)
  /// Точка отсчёта периодов; сами периоды вычисляются на лету, а не хранятся.
  startsAt DateTime
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Один бюджет на связку «пользователь + категория + период».
  /// Важно: в Postgres NULL-значения не конфликтуют между собой, поэтому общих бюджетов
  /// (categoryId = null) с одинаковым периодом может быть несколько — это проверяет сервис.
  @@unique([userId, categoryId, period])
  @@index([userId])
  @@map("budgets")
}

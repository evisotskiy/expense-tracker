// Схема трекера расходов.
// Документация: https://www.prisma.io/docs
//
// Prisma 7: генератор называется `prisma-client`, поле `output` обязательно,
// а строка подключения задаётся не здесь, а в prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // Nest собирается в CommonJS, Next спокойно потребляет CJS — держим один формат на оба приложения.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Пользователи и аутентификация
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?

  /// Валюта по умолчанию для новых транзакций, ISO 4217 (RUB, USD, EUR).
  baseCurrency String @default("RUB") @db.VarChar(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Хранится только хэш refresh-токена: утечка таблицы не даёт выпустить новый access-токен.
/// Каждая ротация создаёт новую строку и помечает старую revokedAt.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Домен: категории, расходы, бюджеты
// ---------------------------------------------------------------------------

model Category {
  id     String @id @default(cuid())
  userId String

  name  String
  /// Имя иконки из lucide-react, например "utensils".
  icon  String?
  /// HEX-цвет для графиков, например "#22c55e".
  color String? @db.VarChar(7)

  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  /// Уникальность в рамках пользователя, а не глобально.
  @@unique([userId, name])
  @@index([userId, isArchived])
  @@map("categories")
}

/// Доход или расход. Одна таблица на оба вида: отличаются они только знаком в отчётах,
/// а запросы (лента, фильтры, итоги за месяц) у них общие.
enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id     String @id @default(cuid())
  userId String
  /// Категория обязательна: транзакция без неё не попадает ни в одну строку отчёта
  /// и молча искажает итоги. Удаление категорий мягкое (isArchived), поэтому Restrict
  /// не мешает «удалить» категорию — он лишь запрещает стереть ту, на которой висит история.
  categoryId String

  /// Decimal(12, 2) — как у Budget: точная арифметика в Postgres, на границе API строка.
  /// Всегда положительная: знак несёт type, иначе «расход -500» и «расход 500» стали бы
  /// двумя способами записать одно и то же.
  amount Decimal         @db.Decimal(12, 2)
  type   TransactionType

  /// ISO 4217. Дублируется в транзакции, чтобы смена User.baseCurrency не переписывала историю.
  currency String @db.VarChar(3)

  description String?  @db.VarChar(500)
  /// Когда деньги реально пришли или ушли (не когда запись создана).
  date        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Главный запрос приложения: «транзакции пользователя за период, свежие сверху».
  /// Он же обслуживает сводку: она фильтрует ровно по userId + диапазону date.
  @@index([userId, date(sort: Desc)])
  /// Нужен проверке Restrict: без него Postgres делает seq scan по transactions
  /// при каждой попытке удалить категорию.
  @@index([categoryId])
  @@map("transactions")
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

model Budget {
  id     String @id @default(cuid())
  userId String
  /// null = общий лимит на все расходы, иначе лимит по конкретной категории.
  categoryId String?

  amount Decimal @db.Decimal(12, 2)

  currency String       @db.VarChar(3)
  period   BudgetPeriod @default(MONTHLY)
  /// Точка отсчёта периодов; сами периоды вычисляются на лету, а не хранятся.
  startsAt DateTime
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Один бюджет на связку «пользователь + категория + период».
  /// Важно: в Postgres NULL-значения не конфликтуют между собой, поэтому общих бюджетов
  /// (categoryId = null) с одинаковым периодом может быть несколько — это проверяет сервис.
  @@unique([userId, categoryId, period])
  @@index([userId])
  @@map("budgets")
}

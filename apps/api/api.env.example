# Скопируйте в apps/api/.env:  cp apps/api/api.env.example apps/api/.env

NODE_ENV=development
PORT=4000

# Откуда разрешены запросы с cookie (адрес фронтенда). Список через запятую.
CORS_ORIGIN=http://localhost:3000

# Секреты JWT. Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=замените_меня_access
JWT_REFRESH_SECRET=замените_меня_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# DATABASE_URL здесь указывать не нужно: ConfigModule подхватывает корневой .env
# вторым файлом (см. envFilePath в src/app.module.ts). Раскомментируйте, только если
# API должен ходить в другую базу, чем миграции Prisma.
# DATABASE_URL="postgresql://expense:expense@localhost:5432/expense_tracker?schema=public"
